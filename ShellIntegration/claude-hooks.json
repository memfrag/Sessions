{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]9;Claude needs input\\007' > \"${SESSIONS_TTY:-/dev/tty}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\033]9;Claude is done\\007' > \"${SESSIONS_TTY:-/dev/tty}\""
          }
        ]
      }
    ]
  }
}
